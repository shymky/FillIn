# Browser-accessible API URL for Whisper /stt/stream (not used by TTS)
# Leave unset to use the browser's hostname on port 9000.
# For a different host or port, set the address reachable from the browser.
# NEXT_PUBLIC_API_URL=http://192.168.1.xxx:9000

# Server-side API URL for /api/tts (defaults to http://localhost:9000)
# Match the FastAPI host and port, as reachable from the Next.js server.
# API_URL=http://localhost:9000
# If uvicorn is started with --port 8000, use API_URL=http://127.0.0.1:8000
# and set NEXT_PUBLIC_API_URL to the browser-accessible API address on port 8000.
